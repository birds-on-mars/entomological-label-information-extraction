# --- STAGE 1: Builder (The "Workshop") ---
FROM python:3.10.14-bookworm AS builder

WORKDIR /build

# Install compilers needed for heavy lifting (torch, opencv, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libjpeg-dev libpng-dev && rm -rf /var/lib/apt/lists/*

# Copy dependency definitions
COPY pyproject.toml /build/
COPY pipelines/requirements /build/pipelines/requirements

# 1. Install the environment in the builder so we can run download scripts
# This resolves NLTK and Torch automatically
RUN pip install --no-cache-dir \
    -r /build/pipelines/requirements/segmentation.txt \
    -r /build/pipelines/requirements/rotation.txt \
    -r /build/pipelines/requirements/classifier.txt \
    -r /build/pipelines/requirements/tesseract.txt \
    -r /build/pipelines/requirements/empty_labels.txt \
    -r /build/pipelines/requirements/postprocess.txt && \
    pip check

# 2. Pre-download Models for offline HPC use
ENV NLTK_DATA=/build/nltk_data
ENV TORCH_HOME=/build/torch_cache
RUN mkdir -p $NLTK_DATA $TORCH_HOME && \
    python -c 'import nltk; nltk.download("punkt", download_dir="/build/nltk_data"); nltk.download("punkt_tab", download_dir="/build/nltk_data");' && \
    python -c "import torchvision.models as models; models.detection.fasterrcnn_resnet50_fpn(weights='FasterRCNN_ResNet50_FPN_Weights.DEFAULT')"

RUN pip freeze > requirements_frozen.txt && \
    pip wheel --no-cache-dir --wheel-dir /build/wheels -r requirements_frozen.txt

# --- STAGE 2: Runner (The "Production Image") ---
FROM python:3.10.14-slim-bookworm AS runner

WORKDIR /app

# Install ONLY the necessary runtime libraries for OpenCV and Tesseract
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx libglib2.0-0 libsm6 libxext6 libxrender1 \
    libstdc++6 libopenblas-dev libomp5 \
    tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

# Copy wheels and pre-downloaded models from Builder
COPY --from=builder /build/wheels /wheels
COPY --from=builder /build/nltk_data /app/nltk_data
COPY --from=builder /build/torch_cache /app/torch_cache

# Install the wheels (Fast and no compiler needed)
RUN pip install --no-cache-dir /wheels/* && rm -rf /wheels

# Copy your actual project code
COPY . /app

# Environment Settings
ENV NLTK_DATA=/app/nltk_data \
    TORCH_HOME=/app/torch_cache \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    LD_LIBRARY_PATH="/.singularity.d/libs"

# Crucial for Apptainer/Singularity: Permissions for cached models
RUN chmod -R 777 /app/nltk_data /app/torch_cache

CMD ["/bin/bash"]